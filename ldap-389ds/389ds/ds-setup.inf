[general]
full_machine_name = localhost
start = False

[slapd]
instance_name = dir
port = 389
root_dn = cn=Directory Manager
root_password = password
self_sign_cert = False

[backend-userroot]
suffix = dc=domain,dc=tld
# Populate the directory with 389 DS 1.3.6 (001003006) sample entries
# https://github.com/389ds/389-ds-base/blob/main/src/lib389/lib389/configurations/__init__.py
sample_entries = 001003006

# vim:ft=config
